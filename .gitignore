# TypeScript
*.tsbuildinfo

# Ignore compiled JavaScript files in TypeScript project directories
/Backend/**/*.js
/Backend/**/*.js.map
/Backend/**/*.d.ts

# Frontend compiled files (not needed as Vite handles this differently)
# But we'll ignore any accidental TypeScript compilation outputs
/Frontend/**/*.js.map
/Frontend/**/*.d.ts

# Keep configuration files
!*.config.js
!vite.config.ts
!tsconfig*.json

# Logs
logs
*.log

