/uploads/*
!/uploads/.gitkeep
!/uploads/bikeImages/
/uploads/bikeImages/*
!/uploads/bikeImages/.gitkeep

# Backend uploads
/Backend/uploads/*
!/Backend/uploads/.gitkeep
!/Backend/uploads/bikeImages/
